# ==============================================================================
# SMART SCHOOL MANAGEMENT SYSTEM - CPANEL & PRODUCTION CONFIGURATION
# Infosof Technologies 2026
# ==============================================================================

# Application Environment (production / development)
CI_ENV=production
APP_URL=https://school.yourcompany.com

# cPanel MySQL Database Credentials
# (Create database and user in cPanel -> MySQL Databases, then paste credentials here)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_smartschool
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=your_cpanel_db_password_here

# Razorpay Online Payment Gateway Integration (Optional: can also be configured via Settings UI)
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_ENABLED=1
