# ==============================================================================
# SMART SCHOOL MANAGEMENT SYSTEM - ENVIRONMENT CONFIGURATION
# Infosof Technologies 2026 (Render Cloud & cPanel Compatible)
# ==============================================================================

# ── Application Environment ──────────────────────────────────────────────────
# Set to 'production' on Render and live hosting, 'development' for local work
CI_ENV=production

# The public URL of your deployed application
# On Render: https://your-service-name.onrender.com
# On cPanel: https://school.yourdomain.com
APP_URL=https://smart-school.onrender.com

# ── Port Configuration ────────────────────────────────────────────────────────
# Render automatically injects $PORT (defaults to 10000). For local Docker: 10000
PORT=10000

# ── MySQL Database Credentials ────────────────────────────────────────────────
# Option 1: Standard Individual Variables (TiDB Cloud, Aiven, Clever Cloud, cPanel)
DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=smart_school
DB_USERNAME=your_database_user
DB_PASSWORD=your_database_password

# Enable TLS/SSL transport for cloud MySQL (Required for TiDB, Aiven, AWS RDS)
DB_SSL=true

# Option 2: Single Connection URL (Alternative if your cloud provider gives a URL)
# MYSQL_URL=mysql://username:password@hostname:3306/smart_school

# ── Database Migration & Seeding ──────────────────────────────────────────────
# Automatically seed schema and default records on container boot (true / false)
AUTO_MIGRATE=true

# Secret token required to trigger migration via browser (/migrate.php?secret=...)
MIGRATION_SECRET=smart_school_init_2026

# ── Razorpay Payment Gateway (Optional) ───────────────────────────────────────
# Can also be configured anytime inside the Admin Dashboard -> Settings -> Razorpay
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
RAZORPAY_ENABLED=0
